generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Satu-satunya pengguna aplikasi ini. Seed awal: username admin.
model PlannerUser {
  id           String           @id @default(cuid())
  username     String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  sessions     PlannerSession[]
}

// Sesi login. Token acak menjadi id; expiresAt jauh ke depan bila
// pengguna memilih "ingat perangkat ini" saat masuk.
model PlannerSession {
  id        String      @id
  userId    String
  user      PlannerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  expiresAt DateTime

  @@index([userId])
}

// Satu baris jadwal mingguan. day: 1 Senin sampai 7 Minggu.
// kind: general (punya period pagi/siang/sore/malam), todo (punya done),
// time (punya time "HH:mm").
model PlannerSchedule {
  id        String   @id @default(cuid())
  day       Int
  kind      String
  period    String?
  time      String?
  text      String
  done      Boolean  @default(false)
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([day, kind, sort])
}

// Pengaturan satu hari latihan: hari istirahat atau tidak, plus catatan.
model PlannerGymDay {
  day    Int     @id
  isRest Boolean @default(false)
  note   String?
  // Nama sesi latihan hari itu, mis. "Leg Day". Gerakan ada di PlannerGymItem.
  title  String?
}

// Satu gerakan latihan pada satu hari.
model PlannerGymItem {
  id        String   @id @default(cuid())
  day       Int
  text      String
  detail    String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([day, sort])
}

// Satu goal pada satu bulan. month format "YYYY-MM".
model PlannerGoal {
  id           String   @id @default(cuid())
  month        String
  text         String
  done         Boolean  @default(false)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())
  // Rentang roadmap harian. Kosong berarti bawaan: mulai tanggal 1
  // bulan goal dan sepanjang bulan itu. Bila diisi, roadmap bebas
  // lintas bulan sampai 366 hari.
  roadmapStart String?
  roadmapDays  Int?

  @@index([month, sort])
}

// Tanda pada satu tanggal kalender. date format "YYYY-MM-DD".
// color: hijau, biru, merah, kuning, ungu.
// reminder: none, email, whatsapp.
model PlannerMark {
  date       String @id
  color      String
  note       String
  reminder   String @default("none")
  // Kapan pengingat dikirim: pagi (pagi hari-H) atau sebelum
  // (5 jam sebelum hari-H, yaitu 19.00 malam sebelumnya).
  // Pengingat hanya berlaku untuk tanda merah (Penting).
  remindWhen String @default("pagi")
}

// Catatan bebas.
model PlannerNote {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// Tugas atau kerjaan dengan tenggat waktu. deadline disimpan sebagai
// momen absolut; masukan formulir ditafsirkan sebagai waktu Jakarta.
model PlannerTask {
  id        String   @id @default(cuid())
  title     String
  note      String   @default("")
  deadline  DateTime
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deadline])
}

// Catatan pengingat deadline yang sudah terkirim, satu baris per
// tugas per ambang (72h, 24h, 6h, 1h), supaya tidak terkirim dobel.
model PlannerReminderLog {
  id        String   @id
  taskId    String
  threshold String
  sentAt    DateTime @default(now())

  @@unique([taskId, threshold])
  @@index([taskId])
}

// Satu butir rencana pada roadmap harian sebuah goal. Satu hari boleh
// berisi banyak butir; date adalah tanggal hari itu (YYYY-MM-DD) dan
// harus berada di dalam rentang roadmap goal.
model PlannerGoalDayItem {
  id     String  @id @default(cuid())
  goalId String
  date   String
  text   String
  done   Boolean @default(false)
  sort   Int     @default(0)

  @@index([goalId, date])
}

// Satu catatan uang masuk atau keluar. Entri hasil aturan tetap
// membawa recurringId dan period (YYYY-MM) dan unik per pasangan itu.
model PlannerMoneyTx {
  id          String   @id @default(cuid())
  kind        String
  name        String
  amount      Int
  date        String
  recurringId String?
  period      String?
  createdAt   DateTime @default(now())

  @@unique([recurringId, period])
  @@index([date])
}

// Pemasukan atau pengeluaran tetap: otomatis menjadi transaksi
// tiap bulan pada tanggal day (dijepit ke akhir bulan bila perlu).
model PlannerMoneyRule {
  id        String   @id @default(cuid())
  kind      String
  name      String
  amount    Int
  day       Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Tombol cepat untuk mencatat pengeluaran atau pemasukan yang sering
// muncul. amount kosong berarti jumlah diisi saat memakai shortcut.
model PlannerMoneyShortcut {
  id     String @id @default(cuid())
  kind   String
  name   String
  amount Int?
  sort   Int    @default(0)

  @@index([kind, sort])
}

// Penanda bahwa entri aturan tetap untuk satu periode sudah dihapus
// pemilik, supaya tidak dibuat ulang oleh materialisasi.
model PlannerMoneySkip {
  id          String @id @default(cuid())
  recurringId String
  period      String

  @@unique([recurringId, period])
}
